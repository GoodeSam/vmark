+/*
+ * VMark patch (#1473): sibling indices without an `indexOf` per text node.
+ *
+ * For every text node, `findAndReplace` looked up each ancestor's index among
+ * its siblings (to pass to the `ignore` test) and the text node's own (to
+ * splice), each with an `indexOf` over the whole children array: O(text nodes
+ * × top-level blocks) on a long flat document, O(siblings²) in a paragraph of
+ * many inline nodes. The answers are unchanged:
+ *
+ * - An ancestor's index is only ever passed to `ignore`, and a type, property
+ *   or `null` test never reads it; only a test function can. So it is computed
+ *   — with `indexOf`, as before — exactly when the test contains a function,
+ *   and left `undefined` otherwise.
+ * - A text node's own index: while its siblings are distinct objects, the one
+ *   index holding it IS `indexOf`'s answer, and it is found by looking outward
+ *   from where the last one was — the traversal moves forward, so that is
+ *   usually a step or two. Distinctness is checked once per array and kept
+ *   up to date through the one edit made here (the splice); an array that is
+ *   not, or stops being, distinct (a replace function returned a node already
+ *   among the siblings) goes back to `indexOf` for good.
+ *
+ * Like the rest of this function, that assumes replace functions and `ignore`
+ * tests return their results rather than editing the tree themselves.
+ */
+
+/**
+ * @typedef {WeakMap<Array<Nodes>, Position | null>} Positions
+ *   Per children array: `null` once it holds an object twice.
+ *
+ * @typedef Position
+ * @property {Set<Nodes>} members
+ *   The array's (distinct) children.
+ * @property {number} hint
+ *   Where the last lookup or splice left off.
+ */
+
+/**
+ * The test with its arrays copied, each element read once: `convert` reads
+ * an array's elements once when it builds its check, and `readsIndex` must
+ * see the same elements.
+ *
+ * @param {Test | null | undefined} test
+ * @returns {Test | null | undefined}
+ */
+function snapshotTest(test) {
+  if (!Array.isArray(test)) return test
+  /** @type {Array<any>} */
+  const copy = []
+  let index = -1
+  while (++index < test.length) {
+    copy.push(snapshotTest(test[index]))
+  }
+
+  return copy
+}
+
+/**
+ * Whether an `ignore` test can observe the index it is given: only a test
+ * function can, including one inside an array of tests.
+ *
+ * @param {Test | null | undefined} test
+ * @returns {boolean}
+ */
+function readsIndex(test) {
+  if (typeof test === 'function') return true
+  if (!Array.isArray(test)) return false
+  let index = -1
+  while (++index < test.length) {
+    if (readsIndex(test[index])) return true
+  }
+
+  return false
+}
+
+/**
+ * `siblings.indexOf(child)`, looking outward from the last position.
+ *
+ * @param {Positions} positions
+ * @param {Array<Nodes>} siblings
+ * @param {Nodes} child
+ * @returns {number}
+ */
+function indexIn(positions, siblings, child) {
+  let position = positions.get(siblings)
+
+  if (position === undefined) {
+    const members = new Set(siblings)
+    position = members.size === siblings.length ? {members, hint: 0} : null
+    positions.set(siblings, position)
+  }
+
+  if (position === null) return siblings.indexOf(child)
+
+  let after = position.hint
+  let before = after - 1
+
+  while (after < siblings.length || before >= 0) {
+    if (after < siblings.length) {
+      if (siblings[after] === child) return (position.hint = after)
+      after++
+    }
+
+    if (before >= 0) {
+      if (siblings[before] === child) return (position.hint = before)
+      before--
+    }
+  }
+
+  return -1
+}
+
+/**
+ * Keep `siblings`' entry true after `removed` at `index` became `inserted`.
+ *
+ * @param {Positions} positions
+ * @param {Array<Nodes>} siblings
+ * @param {number} index
+ * @param {Nodes} removed
+ * @param {Array<Nodes>} inserted
+ * @returns {undefined}
+ */
+function spliced(positions, siblings, index, removed, inserted) {
+  const position = positions.get(siblings)
+  if (!position) return
+  position.members.delete(removed)
+  let offset = -1
+
+  while (++offset < inserted.length) {
+    if (position.members.has(inserted[offset])) {
+      positions.set(siblings, null)
+      return
+    }
+
+    position.members.add(inserted[offset])
+  }
+
+  position.hint = index + inserted.length
+}
