+/**
+ * A `listItem` enter or exit waiting to go into the events (VMark patch #1473).
+ *
+ * @typedef ListItemInsertion
+ * @property {number} at
+ *   Index, in the events as tokenized, of the event it goes in front of.
+ * @property {Event} event
+ *   The enter or exit.
+ */
+
+/**
+ * Insert the queued `listItem` enters and exits into `events`, in one pass.
+ *
+ * VMark patch (#1473): `prepareList` spliced each one into `events` — the
+ * WHOLE document's event array — as it found it, so every list item moved
+ * every later event of the document twice: O(list items × events), whether
+ * the items share one wide list or are spread over many short ones. They are
+ * queued instead, and merged here. (Upstream's fix on `main`,
+ * syntax-tree/mdast-util-from-markdown#51, batches per LIST: it still moves
+ * the rest of the document once per list, and twice per item in a list of up
+ * to four items, so it does not remove this.)
+ *
+ * The result is the array the splices built, event for event:
+ *
+ * - no walk depends on an inserted event. A list's own walk is past an item
+ *   by the time it queues the item's exit, and its backward scan for trailing
+ *   line endings stops at the item's prefix. An enclosing list's walk crosses
+ *   a nested list's items only where `containerBalance` is positive, where an
+ *   item would only reset `atMarker`, which is already unset there; its
+ *   backward scan stops at the nested list's exit, which follows them. So the
+ *   walks decide the same without the insertions, and the indices they take —
+ *   into the events as tokenized — order events exactly as the spliced array
+ *   did: each `at` names the event its splice went in front of.
+ * - so each insertion goes directly in front of its event, and insertions in
+ *   front of the same event keep queue order (an item's exit before the next
+ *   item's enter), as the splices left them. Lists are prepared innermost
+ *   first, so the queue is sorted within a list but not across nested lists;
+ *   `Array#sort` is stable, which keeps that order among equal `at`s.
+ *
+ * @param {Array<Event>} events
+ *   Events as tokenized.
+ * @param {Array<ListItemInsertion>} insertions
+ *   Every list's insertions, in the order `prepareList` queued them.
+ * @returns {Array<Event>}
+ *   Events with the `listItem` enters and exits in place.
+ */
+function insertListItems(events, insertions) {
+  if (insertions.length === 0) return events
+
+  insertions.sort(function (left, right) {
+    return left.at - right.at
+  })
+
+  /** @type {Array<Event>} */
+  const result = []
+  let next = 0
+  let index = -1
+
+  while (++index < events.length) {
+    while (next < insertions.length && insertions[next].at === index) {
+      result.push(insertions[next].event)
+      next++
+    }
+
+    result.push(events[index])
+  }
+
+  assert(next === insertions.length, 'expected every insertion to be placed')
+  return result
+}
